# Environment variables
#
# Salin ke `.env.local` lalu isi. Jangan pernah commit `.env.local` —
# sudah otomatis diabaikan oleh .gitignore.

# ---------------------------------------------------------------------------
# URL situs
# ---------------------------------------------------------------------------
# Dipakai untuk metadata Open Graph / Twitter Card, sitemap.xml, dan
# robots.txt. Tanpa ini, link yang dibagikan ke media sosial akan menunjuk
# ke localhost.
#
# Di Vercel, variabel VERCEL_PROJECT_PRODUCTION_URL dipakai otomatis —
# env ini hanya perlu diisi kalau deploy di host lain.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Form kontak
# ---------------------------------------------------------------------------
# Form kontak BELUM tersambung ke layanan email. Tanpa kunci di bawah,
# `sendContactMessage()` di lib/contact.ts menolak dengan pesan jujur dan
# form menampilkan "belum aktif" — bukan melaporkan pesan terkirim.
#
# Cara mengaktifkan:
#   1. Buat akun di https://resend.com, ambil API key
#   2. Isi RESEND_API_KEY di file ini
#   3. (Opsional) verifikasi domain sendiri agar bisa mengirim ke siapa pun
#
# Lihat lib/contact.ts untuk sisi servernya.

# Kunci API dari resend.com
RESEND_API_KEY=

# Email tujuan — pesan kontak dikirim ke sini
CONTACT_TO_EMAIL=abdi.raihan.wibowo@gmail.com

# Email pengirim. Selama domain belum diverifikasi, Resend hanya boleh
# mengirim ke email pemilik akun, jadi nilai default ini hanya untuk testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev
